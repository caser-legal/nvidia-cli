# NVIDIA NIM API Key (get from build.nvidia.com)
# Single key powers: LLM, Embeddings, Reranker, Vision
NVIDIA_API_KEY=nvapi-your-key-here

# Optional: Google Custom Search (for web search tools)
# GOOGLE_API_KEY=your-google-api-key
# GOOGLE_CSE_ID=your-custom-search-engine-id

# Optional: Local LLM (instead of NVIDIA hosted API)
# USE_LOCAL_LLM=true
# OLLAMA_BASE_URL=http://localhost:11434
# LOCAL_EMBED_URL=http://192.168.50.50:8000
